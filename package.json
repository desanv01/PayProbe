{
  "name": "payprobe", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24.14.0 <25" },
  "bin": { "payprobe": "dist/cli/index.js" },
  "scripts": {
    "dev": "tsx src/cli/index.ts", "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit", "build": "tsc", "test": "tsx --test tests/*.test.ts",
    "test:runner": "node --import tsx --test src/runner/runner.test.ts",
    "test:workflow": "node --import tsx --test src/ai/workflow.test.ts",
    "test:stabilization": "node --import tsx --test tests/stabilization/payment-http.test.ts tests/stabilization/cli-process.test.ts",
    "test:ui": "node --import tsx --test src/ui/tui.test.ts src/web/routes.test.ts"
  },
  "dependencies": { "commander": "^14.0.0", "dotenv": "^17.2.0", "fastify": "^5.6.0", "openai": "^6.0.0", "zod": "^4.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
